{
  "name": "@pdfly/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "fastify": "5.12.3",
    "playwright": "1.63.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
