# ---------------------------------------------------------------------------
# PDFly — local development environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- api ---------------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
LOG_LEVEL=debug

# --- postgres ----------------------------------------------------------
POSTGRES_USER=pdfly
POSTGRES_PASSWORD=pdfly
POSTGRES_DB=pdfly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pdfly:pdfly@localhost:5432/pdfly?schema=public

# --- redis -------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- object storage (MinIO locally, R2/S3 in production) ---------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pdfly
S3_ACCESS_KEY_ID=pdfly
S3_SECRET_ACCESS_KEY=pdfly-dev-secret
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=9001

# --- renderer (Phase 1) ---------------------------------------------------
RENDERER_URL=http://localhost:3002
RENDERER_PORT=3002
POOL_SIZE=2
MAX_HTML_BYTES=5242880
RETENTION_DAYS=7
DOWNLOAD_URL_TTL_SECONDS=900

# --- auth (Phase 2) ----------------------------------------------------
# Signs dashboard access tokens. Refresh tokens are opaque values held in
# Redis, so they need no second signing secret.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- queue and webhooks (Phase 6) --------------------------------------
# Async render workers in the api process. 0 enqueues but never consumes.
QUEUE_CONCURRENCY=2
# HMAC key for outgoing webhook signatures.
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me-000000
# Webhooks to localhost are an SSRF hole in production; handy in development.
WEBHOOK_ALLOW_PRIVATE=true

# --- secrets -----------------------------------------------------------
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key used to encrypt smtp_configs.password_encrypted (§4)
ENCRYPTION_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLTAwMDAwMDAwMDAwMDA=

# --- web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
